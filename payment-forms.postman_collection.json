            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salaryDeduction\": {\n    \"memberFullName\": \"JANE MEMBER\",\n    \"employedAt\": \"St James Hospital\",\n    \"payrollStaffNo\": \"12345\",\n    \"commencingDate\": \"2026-06-01T00:00:00.000Z\",\n    \"signedDate\": \"2026-05-23T00:00:00.000Z\"\n  },\n  \"gdpr\": {\n    \"consentCapturedAt\": \"2026-05-23T12:00:00.000Z\"\n  }\n}"
            },
