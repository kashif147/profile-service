              "raw": "{\n  \"standingOrder\": {\n    \"debtorBankName\": \"AIB\",\n    \"debtorBankAddress\": \"1 Bank Centre, Dublin 2\",\n    \"debtorAccountName\": \"Jane Member\",\n    \"debtorIban\": \"IE29AIBK93115212345678\",\n    \"debtorBic\": \"AIBKIE2D\",\n    \"startDate\": \"2026-06-01T00:00:00.000Z\",\n    \"paymentFrequency\": \"Monthly\",\n    \"installmentAmountEur\": 45,\n    \"signatureDates\": [\n      \"2026-05-23T00:00:00.000Z\",\n      \"2026-05-23T00:00:00.000Z\"\n    ]\n  },\n  \"gdpr\": {\n    \"consentCapturedAt\": \"2026-05-23T12:00:00.000Z\"\n  }\n}"
            },
