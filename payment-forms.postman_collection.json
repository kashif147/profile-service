            }
          }
        },
        {
          "name": "Submit form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/portal/{{paymentFormId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "portal", "{{paymentFormId}}", "submit"]
            },
            "description": "Electronic submit; records client IP and user agent."
          }
        },
        {
          "name": "Upload signature (canvas PNG)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageBase64\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n  \"slot\": 0,\n  \"signedDate\": \"2026-05-23T12:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/portal/{{paymentFormId}}/upload-signature",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "portal", "{{paymentFormId}}", "upload-signature"]
            },
            "description": "Optional drawn signature from portal canvas.\n\n**JSON:** `imageBase64` (data URL or raw base64), optional `slot` (0|1 for standing order), optional `signedDate`.\n\n**Multipart alternative:** `file` (PNG/JPEG), `slot`, `signedDate`.\n\nStored in Azure Blob; paths saved on form:\n- STANDING_ORDER → `standingOrder.signatureBlobPaths[slot]`\n- SALARY_DEDUCTION → `salaryDeduction.signatureBlobPath`\n- DD_MANDATE → `directDebitMandate.signatureBlobPaths[slot]`\n\nGET response includes `downloadUrls.signatures[]` SAS URLs.\n\nAlternatively include on PATCH: `signatures: [{ imageBase64, slot, signedDate }]`."
          }
        },
        {
          "name": "Upload signature (multipart file)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "PNG or JPEG" },
                { "key": "slot", "value": "0", "type": "text" },
                { "key": "signedDate", "value": "2026-05-23T12:00:00.000Z", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/portal/{{paymentFormId}}/upload-signature",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "portal", "{{paymentFormId}}", "upload-signature"]
            }
          }
        },
        {
          "name": "Upload signed PDF",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Signed PDF file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/portal/{{paymentFormId}}/upload-signed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "portal", "{{paymentFormId}}", "upload-signed"]
            }
          }
        }
      ]
    },
    {
      "name": "CRM",
      "description": "Staff CRM APIs on profile-service.",
      "item": [
        {
          "name": "Prefill (preview, not saved)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/prefill?profileId={{profileId}}&formType={{formType}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "prefill"],
              "query": [
                { "key": "profileId", "value": "{{profileId}}" },
                { "key": "formType", "value": "{{formType}}", "description": "STANDING_ORDER | SALARY_DEDUCTION | DD_MANDATE" }
              ]
            }
          }
        },
        {
          "name": "Filter / list",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"formType\": \"STANDING_ORDER\",\n    \"status\": \"submitted\",\n    \"membershipNumber\": \"123456\"\n  },\n  \"page\": 1,\n  \"limit\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/filter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", "filter"]
            }
          }
        },
        {
          "name": "Create draft (CRM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const form = json?.data?.paymentForm || json?.paymentForm;",
                  "if (form?._id) pm.collectionVariables.set('paymentFormId', form._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileId\": \"{{profileId}}\",\n  \"formType\": \"STANDING_ORDER\",\n  \"source\": \"post\",\n  \"standingOrder\": {\n    \"debtorBankName\": \"AIB\",\n    \"debtorBankAddress\": \"1 Bank Centre, Dublin 2\",\n    \"debtorAccountName\": \"Jane Member\",\n    \"debtorIban\": \"IE29AIBK93115212345678\",\n    \"debtorBic\": \"AIBKIE2D\",\n    \"startDate\": \"2026-06-01T00:00:00.000Z\",\n    \"paymentFrequency\": \"Monthly\",\n    \"installmentAmountEur\": 45,\n    \"signatureDates\": [\n      \"2026-05-23T00:00:00.000Z\",\n      \"2026-05-23T00:00:00.000Z\"\n    ]\n  },\n  \"gdpr\": {\n    \"consentCapturedAt\": \"2026-05-23T12:00:00.000Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-forms/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-forms", ""]
            },
            "description": "**source** (optional): `post` | `email` | `walk_in` | `phone` | `crm`. Records how the form was received. Defaults to `post` when omitted. Portal endpoints always set `portal` server-side."
          }
        },
        {
